# Native Gemini API pass-through for File Search MCP (SPEC §11).
# Install: cp packaging/gemini-router-proxy.service /etc/systemd/system/
#          printf 'GEMINI_ROUTER_PROXY_TOKEN=%s\n' "$(openssl rand -hex 32)" \
#              >> /opt/apps/gemini-mcp/.env
#          systemctl daemon-reload && systemctl enable --now gemini-router-proxy
#
# It reuses the gateway's EnvironmentFile, so it sees the SAME key pool and the SAME
# state.db — quota truth stays shared with gemini-mcp, stdio sessions and the CLI.
# Loopback only: never publish this port.
[Unit]
Description=gemini-router — native Gemini API pass-through for File Search (127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
User=gemini
WorkingDirectory=/opt/apps/gemini-mcp
EnvironmentFile=/opt/apps/gemini-mcp/.env
ExecStart=/opt/apps/gemini-mcp/.venv/bin/gemini-router proxy
Restart=on-failure
RestartSec=3
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/apps/shared/gemini-router

[Install]
WantedBy=multi-user.target
