<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local :8790 -> VPS :8790 for gemini-mcp, plus :8787 -> VPS :8787 for the native
     Gemini pass-through (gemini-router proxy). ONE ssh process, both forwards: a
     second launchd agent would open a second connection and double the keepalive
     traffic for no gain.

     Install: cp packaging/com.vernikr.gemini-tunnel.plist \
                    ~/Library/LaunchAgents/com.vernikr.gemini-tunnel.plist
              launchctl unload ~/Library/LaunchAgents/com.vernikr.gemini-tunnel.plist
              launchctl load   ~/Library/LaunchAgents/com.vernikr.gemini-tunnel.plist

     launchd keeps it alive: restart on death, after sleep, at login. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vernikr.gemini-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=4</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-L</string><string>8790:127.0.0.1:8790</string>
    <string>-L</string><string>8787:127.0.0.1:8787</string>
    <string>gemini-vps</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/gemini-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gemini-tunnel.log</string>
</dict>
</plist>
